# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=country_store
DB_USERNAME=root
DB_PASSWORD=development
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_TTL=3600000

# Server
PORT=8000

# Spring profile: leave empty locally (human-readable logs).
# Containers set SPRING_PROFILES_ACTIVE=docker (Compose) or =k8s (Kubernetes)
# to switch to structured JSON logging on stdout.
SPRING_PROFILES_ACTIVE=

# Root log level (INFO by default)
LOG_LEVEL=INFO

# Background sync (first run is immediate, then every SYNC_INTERVAL in ms)
SYNC_INTERVAL=86400000

# In-memory cache TTL in seconds
CACHE_TTL=300

# Vacuum policy for soft-deleted countries (hard delete after retention)
VACUUM_INTERVAL=3600000
VACUUM_RETENTION=7d
